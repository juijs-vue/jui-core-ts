{
  "name": "jui-core-ts",
  "version": "0.1.0",
  "sideEffects": false,
  "description": "Framework-agnostic TypeScript port of the JUI core utilities (juijs/jui-core), for the Vue-based jui-*-vue/jui-*-ts family.",
  "type": "module",
  "main": "dist/jui-core.cjs",
  "module": "dist/jui-core.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/jui-core.esm.js",
      "require": "./dist/jui-core.cjs"
    }
  },
  "scripts": {
    "build": "npm run build:types && npm run build:bundle",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "rollup -c",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/juijs/jui-core.git"
  },
  "keywords": [
    "HTML5",
    "TypeScript",
    "SVG",
    "Chart",
    "Framework",
    "Web Development"
  ],
  "author": "seogi1004",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rollup": "^4.18.0",
    "ts-jest": "^29.1.5",
    "tslib": "^2.6.3",
    "typescript": "^5.5.2"
  }
}
